# agent-suite system config — PLACEHOLDERS ONLY. Copy to the system path
# (/etc/agent-suite/suite.env or %ProgramData%\agent-suite\suite.env) and fill in.
# Secrets are backend refs, never literals. The resolver's scheme names are
# vault: / azure: / windows: / file: / env: (NOT akv:/wincred:), and a vault ref
# is vault:<mount>/<path...>/<field> — the field is the LAST PATH SEGMENT, never
# a '#field' suffix. `agent-suite bootstrap` step 0 resolves every ref named
# here and aborts on any that does not resolve.
#
# The per-user overlay (~/.config/agent-suite/suite.env) holds each human's
# principal_id and default project. The system file holds shared facts.

# --- Spine (regista) ---
# The DSN carries its own password: regista has no REGISTA_DSN_PASSWORD.
REGISTA_DSN=postgresql://DB-SERVICE-ACCOUNT:PASSWORD@suite-db.example:5432/regista
# A path to a keys.json FILE, not a ref. Custodied keys are per-key
# "secret_ref" entries inside it — see docs/secrets-vault.md 4.1.
REGISTA_KEY_PATH=/etc/agent-suite/keys.json
REGISTA_REQUIRE_SSL=true

# --- agent-notes native DB ---
# agent-notes uses its own database (separate from the regista store) for
# memories, links, and the op_log. If this is the same Postgres instance,
# create a dedicated database + role for agent-notes. If unset, agent-notes
# falls back to REGISTA_DSN from this file.
AGENT_NOTES_DSN=postgresql://DB-SERVICE-ACCOUNT-2@suite-db.example:5432/agent_notes
AGENT_NOTES_REGISTA_WRITES=1

# --- cairn (provenance) ---
CAIRN_PROJECT=agent_provenance
# Content encryption is ON by default with NO key. cairn's doctor then warns
# "Content encryption is ON but no content key configured ... Content capture
# will store plaintext until a key is set" — and it warns rather than fails, so
# `doctor --exit-code` stays 0 over a plaintext-by-default posture
# (agent-provenance WI-035). Set this on any host that captures real content.
CAIRN_CONTENT_KEY_REF=vault:kv/agent-suite/hosts/HOSTNAME/cairn/content_key
# Chain-integrity verdict location + staleness window (cairn WI-030).
# The scheduled `cairn integrity` timer runs as root while doctors run as
# humans — both must read/write the SAME directory or human-run doctors
# report "never_run" forever. The systemd unit defaults to this path; set it
# here so every reader agrees. The window (hours) must exceed the weekly
# cadence with margin or catch-up jitter causes transient stale warnings.
CAIRN_INTEGRITY_DIR=/var/lib/agent-suite/cairn
CAIRN_INTEGRITY_MAX_AGE_HOURS=192
# NOTE: cairn resolves the FIRST suite.env it finds (~/.config wins over
# /etc, no merge) — every per-user overlay must repeat CAIRN_INTEGRITY_DIR
# or that user's doctor reports never_run.

# --- Vault custody: how this host AUTHENTICATES to Vault ---
# Every component that resolves a vault: ref authenticates on its own, in its own
# process. docs/secrets-vault.md §6 is the full account; §6.3 is the doctor row
# that tells you which method a host actually ended up on:
#   regista doctor --json | jq '.checks[]|select(.name=="custody:vault_auth")'
# ok = AppRole (production), warn = static token (dev-only), fail = credentials
# present but unusable. Run it PER COMPONENT — each resolves in its own venv.
VAULT_ADDR=https://vault.work-domain.example:8200
#
# OPTION A — a shared plane file (docs/secrets-vault.md §6.2). When acb
# provisions this host's AppRole it writes a mode-0600 env-style file carrying
# VAULT_ADDR / VAULT_ROLE_ID / VAULT_SECRET_ID. Those are the same names regista
# reads, so pointing VAULT_ENV_FILE at it makes ONE credential file serve both
# components. The process environment still wins over the file, so an explicit
# variable below overrides a provisioned plane. A named-but-missing file is an
# error, never a silent fall-through to ambient credentials.
# VAULT_ENV_FILE=/etc/agent-suite/vault-plane.env
#
# OPTION B — name the credentials directly. Prefer the *_FILE forms: a 0600
# root-owned file keeps the credential out of /proc/<pid>/environ.
VAULT_ROLE_ID_FILE=/etc/agent-suite/vault-role-id
# VAULT_ROLE_ID=<inline RoleID; use VAULT_ROLE_ID_FILE instead where possible>
VAULT_SECRET_ID_FILE=/etc/agent-suite/vault-secret-id
# VAULT_SECRET_ID=<inline SecretID; the file form is preferred>
# Set to 1 when VAULT_SECRET_ID_FILE holds a response-WRAPPING token rather than
# the SecretID itself (docs/secrets-vault.md §5.1). Delivery is one-shot: a second
# unwrap of the same token returns HTTP 400, which the Linux qualification
# confirmed against live Vault. Setting this without VAULT_SECRET_ID_FILE is an
# error, not a silent downgrade.
# VAULT_SECRET_ID_RESPONSE_WRAPPED=1
# The auth mount. Default: approle.
# VAULT_APPROLE_MOUNT_POINT=approle
#
# DEV ONLY. A static token, kept so `vault server -dev` still works. A production
# host operates AppRole-only with no VAULT_TOKEN in its environment. Setting any
# AppRole variable above means AppRole and this is then never consulted: a RoleID
# with no SecretID is an error naming the missing variable, because falling back
# would turn a broken production posture into a working dev one silently.
# VAULT_TOKEN=dev-only-token

# --- Principal identity ---
# Set in the PER-USER overlay, not the system file. Each human/agent gets
# their own principal_id. The bootstrap provisions the Ed25519 keypair.
# PRINCIPAL_ID=your-principal-id

# --- Per-consumer project slugs (set in per-user overlay) ---
# AGENT_NOTES_PROJECT=project-slug
# DOSSIER_PROJECTS=project-slug,another-slug

# --- Shared-service endpoints (Plan 004 WI-1.6) ---
# Dossier deploys centrally as the team URL; the doctor checks it by endpoint
# instead of requiring a local install. When set, doctor reports
# "remote: ok @ <version>" for dossier; when unset, "not configured (shared
# service)" — a named state distinct from failure.
# DOSSIER_URL=https://dossier.work-domain.example

# =============================================================================
# PROFILE B — dossier, the human face (WI-047)
# =============================================================================
# Skip this whole block on a Profile A host, or where dossier is a shared
# service reached through DOSSIER_URL above. On a host that RUNS dossier, the
# variables marked REQUIRED are not optional: dossier refuses to start without
# DOSSIER_SESSION_SECRET, and the rest decide whether the deployment is safe.
#
# The completeness of this block is asserted by
# tests/test_config_surface.py against src/agent_suite/config_surface.py, which
# in turn is checked against dossier's own config module wherever dossier is
# installed. This file used to name two dossier variables, both commented out,
# while calling itself "the canonical placeholder set".
#
# dossier reads REGISTA_DSN and REGISTA_KEY_PATH from the Spine block above.

# --- Required: dossier will not start without these ---
# Signed-cookie secret, >= 32 bytes. A backend ref is NOT resolved for this one
# (dossier WI-036) — it must be a literal in the environment dossier's own
# process sees, so keep it OUT of this shared file and inject it into the unit
# (systemd `EnvironmentFile=` pointing at a 0600 root-owned file, or
# `LoadCredential=`). The line is here so the variable is discoverable, not so
# the secret lives here.
# DOSSIER_SESSION_SECRET=<32+ bytes, injected into the service, never committed>
DOSSIER_ENV=prod
DOSSIER_USERS_PATH=/etc/dossier/users.json
DOSSIER_AUTH_BACKEND=local
# Where per-principal signing keys live. dossier REFUSES to derive this when
# REGISTA_KEY_PATH is a remote backend ref, because deriving would drop private
# keys into the process CWD. Set it explicitly.
DOSSIER_PRINCIPAL_KEY_DIR=/etc/agent-suite/principals
# Which regista project(s) this dossier fronts.
DOSSIER_PROJECTS=project-slug

# --- Per-actor human signing (dossier WI-035 / PR #12) ---
# `require` refuses a human write that could only be signed with the shared
# store-level HMAC key; `warn` records it but says so in the log, the response,
# the UI and the doctor. Never silent in either mode. `require` is the default
# under DOSSIER_ENV=prod and is what bootstrap-contract.md §5 requires: the Linux
# qualification's human `accept` was signed with the store key, so anyone holding
# that key could have produced the one signature representing human judgement.
DOSSIER_HUMAN_SIGNING=require
# HOW AN IDENTITY BINDS TO A regista PRINCIPAL — not an env var for the local
# backend: add a `principal_id` field to each human's entry in
# DOSSIER_USERS_PATH, and it becomes the actor_id on their signed events. regista
# rejects any event whose actor_id differs from its key's principal_id, so an
# identity signing under an id no key is registered against cannot carry a
# per-actor signature at all. For the ldap backend, see
# DOSSIER_LDAP_PRINCIPAL_ID_ATTR below.

# --- TLS and cookie posture ---
# Serve HTTPS directly: set BOTH. Setting only one is a fail-loud configuration
# error at serve time, never a silent plaintext fallback.
DOSSIER_TLS_CERT_PATH=/etc/dossier/tls/fullchain.pem
DOSSIER_TLS_KEY_PATH=/etc/dossier/tls/privkey.pem
# ...OR, when an ingress/proxy terminates TLS instead, leave the pair unset and
# declare the posture so the doctor reports ok rather than failing in prod:
# DOSSIER_BEHIND_TLS_PROXY=true
DOSSIER_SECURE_COOKIES=true
# NOTE: DOSSIER_REQUIRE_SSL governs the *Postgres* connection, not the web
# listener. A co-located database on loopback with no server certificate needs
# this false even in prod.
DOSSIER_REQUIRE_SSL=true
# Comma-separated Host headers. Wires TrustedHostMiddleware only when set.
DOSSIER_ALLOWED_HOSTS=dossier.work-domain.example
# Session lifetime. Shorten it during a principal_id changeover so sessions
# carrying the old binding cannot outlive it.
DOSSIER_SESSION_MAX_AGE_SECONDS=43200
# The URL humans are sent to; notification links are wrong without it.
DOSSIER_BASE_URL=https://dossier.work-domain.example

# --- Project access (deny by default, dossier WI-017) ---
# `enforce` (default) | `audit` | `open`. Flat-open — every authenticated
# principal reads every project — is available but must be chosen explicitly.
DOSSIER_PROJECT_ACCESS_MODE=enforce
# enforce with NO ACL file and NO bootstrap admins denies everything. dossier
# resolves rather than crashing (so the doctor can tell you why) but nobody can
# read anything, so set at least one of these two.
DOSSIER_PROJECT_ACL_PATH=/etc/dossier/project-acl.json
DOSSIER_BOOTSTRAP_ADMINS=admin-principal-id

# --- LDAP (required when DOSSIER_AUTH_BACKEND=ldap; ignored otherwise) ---
# Plaintext LDAP is refused outright, and strict mode will not fall back to the
# system trust store.
# DOSSIER_LDAP_SERVER=ldaps://dc1.work-domain.example,ldaps://dc2.work-domain.example
# DOSSIER_LDAP_BASE_DN=DC=work-domain,DC=example
# DOSSIER_LDAP_BIND_DN=CN=dossier-svc,OU=Service Accounts,DC=work-domain,DC=example
# DOSSIER_LDAP_BIND_PASSWORD=vault:kv/agent-suite/hosts/HOSTNAME/dossier/ldap_bind_password
# DOSSIER_LDAP_DOMAIN=work-domain.example
# DOSSIER_LDAP_CA_CERT_FILE=/etc/dossier/tls/ad-root-ca.pem
# The directory attribute carrying each human's regista principal_id. UNSET
# means LDAP identities are unbound and their events cannot be attributed to a
# person (dossier WI-035).
# DOSSIER_LDAP_PRINCIPAL_ID_ATTR=employeeID
# DOSSIER_LDAP_USER_FILTER=(&(objectClass=user)(sAMAccountName={login}))
# DOSSIER_LDAP_GROUP_STRATEGY=direct
# DOSSIER_LDAP_CONNECT_TIMEOUT=5

# --- Notification delivery (optional; off until configured) ---
# DOSSIER_NOTIFICATION_SINK=https://sink.work-domain.example/hook
# DOSSIER_NOTIFICATION_SECRET_REF=vault:kv/agent-suite/hosts/HOSTNAME/dossier/notification_secret
# DOSSIER_NOTIFICATION_SOURCE=dossier
# DOSSIER_NOTIFICATION_IDENTITY=dossier@work-domain.example
# Unset means notification preferences do not survive a restart.
# DOSSIER_NOTIFICATION_PREF_DIR=/var/lib/dossier/notification-prefs

# Single-project alias for DOSSIER_PROJECTS (default: "dossier").
# DOSSIER_PROJECT=project-slug

# --- Memory provider (Plan 012 WI-1.1) ---
# agent-notes supports a pluggable memory engine. The default is "native"
# (no external dependency). Set AGENT_NOTES_MEMORY_ENGINE=hindsight to use
# the Hindsight learned-context engine; HINDSIGHT_URL must be set when
# the engine is hindsight. The doctor checks hindsight reachability and
# makes suite_ok False on outage — no silent fallback to native.
# AGENT_NOTES_MEMORY_ENGINE=hindsight
# HINDSIGHT_URL=https://hindsight-api.work-domain.example
# HINDSIGHT_TENANT=default

# --- Codex plugin marketplace (Plan 007) ---
# The release marketplace is "agent-suite". Set this only when the installed
# plugins intentionally come from another qualified source, such as a local
# dogfood marketplace. The doctor never accepts an unqualified same-name
# plugin as satisfying the release pin.
# AGENT_SUITE_CODEX_MARKETPLACE=agent-suite-local

# --- Entra (Azure AD) step-up authentication (Plan 014 WI-3.3) ---
# Optional: enables Entra JWT token validation for dual control.
# When configured, the EntraTokenValidator fetches JWKS keys automatically.
# ENTRA_TENANT_ID=tenant-id-placeholder
# ENTRA_CLIENT_ID=client-id-placeholder
# ENTRA_AUDIENCE=api://agent-suite
