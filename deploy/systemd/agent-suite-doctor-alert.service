[Unit]
Description=Periodic doctor health check + alert routing on state change
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/agent-suite alert-check
Environment=CAIRN_INTEGRITY_DIR=/var/lib/agent-suite/cairn
Environment=PATH=/usr/local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=-/etc/agent-suite/suite.env
User=root

[Install]
WantedBy=multi-user.target
